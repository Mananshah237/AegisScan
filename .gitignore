docker-compose.override.yml

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Project specific
artifacts/
reports/
logs/
scan-results-*.json

# Claude Code internal
.claude/
CLAUDE.md

# Ensure frontend source is always tracked (guards against the broad lib/ rule)
!frontend/src/lib/
!frontend/src/lib/**
